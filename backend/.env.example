# Backend Environment Variables Example
# Copy this file to .env and fill in actual credentials for local development.

# Application Configuration
APP_NAME="Agentic LMS"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Security & Authentication
SECRET_KEY="PasswordSuperRahasiaGantiKeyJanganJupa"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration (PostgreSQL / asyncpg)
# DB_PASSWORD disamakan dengan default POSTGRES_PASSWORD pada docker-compose.yml
# supaya backend yang dijalankan di host (uv run uvicorn) dapat terhubung ke
# database container (`docker compose up -d`) tanpa mengubah nilai apa pun.
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="postgres"
DB_NAME="lms_moodle_db"
DATABASE_URL=""

# CORS Configuration (JSON array or comma-separated list of origins)
# Origin frontend development (Vite berjalan di port 3000). Origin harus
# eksplisit scheme://host[:port]; wildcard, path, dan trailing slash tidak
# dipakai. Origin production ditentukan pada environment deployment, bukan
# di-hardcode di sini (BE-06.2).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Moodle Integration
MOODLE_BASE_URL="http://localhost:8080/moodle"
MOODLE_WEB_SERVICE_TOKEN="your_moodle_webservice_token_here"

# LLM / Agentic AI Configuration
# LLM_PROVIDER selects the active provider: "openai" or "gemini".
LLM_PROVIDER="openai"

# Optional shared credential/model fallback. Prefer the provider-specific values
# below: a shared value only applies to the provider selected by LLM_PROVIDER.
# Never expose these values to the frontend.
LLM_API_KEY=""
LLM_MODEL=""

# Provider-specific LLM credentials and models (optional).
# This is the preferred place to configure a provider. An empty model means the
# provider's own provisional default is used.
# The model is provisional: the final model is decided after the model
# evaluation required by PRD AIR-008, so it must stay configurable here.
OPENAI_API_KEY=""
OPENAI_MODEL=""
GEMINI_API_KEY=""
GEMINI_MODEL=""

# Optional OpenAI-compatible endpoint override. Leave empty for the official
# OpenAI API, or point it to a local runtime to develop offline, e.g. Ollama:
#   OPENAI_BASE_URL="http://localhost:11434/v1"
#   OPENAI_API_KEY="ollama"
#   OPENAI_MODEL="qwen2.5:7b"
OPENAI_BASE_URL=""

# RPS Upload & Docling Conversion (BE-05)
# Storage location for uploaded RPS files and their conversion artifacts.
# Empty means backend/var/rps (gitignored). The directory must be writable by
# the application user, and should be a persistent volume in Docker.
RPS_STORAGE_DIR=""

# Maximum accepted upload size in bytes (default 20 MiB). RPS documents are text
# documents; this bound protects the server from unreasonable uploads.
RPS_MAX_UPLOAD_BYTES=20971520

# Accepted file extensions, comma-separated. "pdf" only, matching the M02 scope
# (RPS PDF with a program-study template). design-api §6.1 also allows DOCX —
# enable it with "pdf,docx"; Docling supports both without code changes.
RPS_ALLOWED_EXTENSIONS="pdf"

# Document converter (see src/services/rps/factory.py). Docling is an optional
# dependency: install it with `uv sync --extra docling`. Without it the API still
# runs, but POST /api/v1/rps/{id}/process fails with 500 RPS_PROCESSING_FAILED
# and a server-side message naming the install command.
RPS_CONVERTER="docling"

# OCR for pages without a text layer (scanned RPS). Enabled by default, following
# Docling's own default; disabling it speeds up digital PDFs but makes scanned
# documents convert to an empty result.
RPS_CONVERTER_OCR=true

# Table structure extraction. Enabled by default: the weekly distribution and
# assessment weights of an RPS are tables, and flattening them loses academic
# data that BE-08 needs.
RPS_CONVERTER_TABLE_STRUCTURE=true

# TableFormer mode: "accurate" or "fast".
RPS_CONVERTER_TABLE_MODE="accurate"

# Directory of pre-downloaded Docling models (offline deployment):
#   docling-tools models download --output-dir ./var/docling-models
# Empty means Docling uses its own cache ($HOME/.cache/docling, or
# DOCLING_CACHE_DIR / HF_HOME when those are set).
RPS_CONVERTER_ARTIFACTS_PATH=""

# How long (seconds) a processing run is considered still alive. A document left
# in PROCESSING for longer than this may be processed again, so a conversion
# interrupted by a server restart does not lock the document forever.
RPS_PROCESSING_LEASE_SECONDS=900

# RPS Analysis (BE-08.2)
# Additional retries when the model output is not valid RPS Structured Data
# after the first attempt (default 2, maximum 5). Retries only apply to invalid
# output; provider failures (timeout/rate limit) are reported immediately.
RPS_ANALYSIS_MAX_FIX_ATTEMPTS=2

# Instructor Setup (BE-10.2)
# Maximum length of the instructor's Additional Prompt, in characters (default
# 2000). The prompt is sent to the LLM together with the RPS YAML, so it is
# bounded to keep the academic context dominant (PRD FR-012).
INSTRUCTOR_ADDITIONAL_PROMPT_MAX_LENGTH=2000
