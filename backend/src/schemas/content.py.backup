from __future__ import annotations

from datetime import datetime

from pydantic import BaseModel, ConfigDict, Field

from src.models.content import ContentStatus, ContentType

TITLE_MAX_LENGTH = 255  # harus sama dengan String(255) pada kolom contents.title


# --------------------------------------------------------------------------
# 1. Input LLM (dibangun dari database)
# --------------------------------------------------------------------------


class OutcomeRef(BaseModel):
    model_config = ConfigDict(extra="forbid", str_strip_whitespace=True)

    id: str | None = None
    description: str = Field(min_length=1)


class WeekContext(BaseModel):
    """Konteks satu minggu untuk content generator. Dibangun dari database."""

    model_config = ConfigDict(extra="forbid", str_strip_whitespace=True)

    # Dipakai backend untuk menyimpan hasil; TIDAK dikirim ke LLM.
    course_plan_week_id: str | None = None

    # Identitas mata kuliah
    name: str = Field(min_length=1)
    description: str | None = None
    semester: int | None = None

    # Rencana minggu ini
    week: int = Field(ge=1)
    topics: list[str] = Field(default_factory=list)
    cpmk: list[OutcomeRef] = Field(default_factory=list)
    sub_cpmk: list[OutcomeRef] = Field(default_factory=list)
    teaching_method: list[str] = Field(default_factory=list)
    media: list[str] = Field(default_factory=list)
    indicators: list[str] = Field(default_factory=list)

    def to_prompt_dict(self) -> dict:
        """Kelompokkan field mata kuliah agar `name` tidak ambigu bagi LLM."""
        data = self.model_dump(mode="json", exclude={"course_plan_week_id"})
        return {
            "course": {
                "name": data.pop("name"),
                "description": data.pop("description"),
                "semester": data.pop("semester"),
            },
            **data,
        }


# --------------------------------------------------------------------------
# 2. Output LLM
# --------------------------------------------------------------------------


class ContentOutputModel(BaseModel):
    """Base untuk model yang diisi LLM. extra="forbid": field liar = gagal validasi."""

    model_config = ConfigDict(extra="forbid", str_strip_whitespace=True)


class LearningItem(ContentOutputModel):
    """Satu materi. Dipetakan ke SATU baris `contents`."""

    name: str = Field(min_length=1, max_length=TITLE_MAX_LENGTH)  # -> contents.title
    material_learning: str = Field(min_length=1)  # -> contents.content_markdown


class GeneratedLearningMaterial(ContentOutputModel):
    """Root output LLM untuk satu minggu."""

    content_learning: list[LearningItem] = Field(min_length=1)


# --------------------------------------------------------------------------
# 3. Insert ke tabel contents
# --------------------------------------------------------------------------


class ContentCreate(BaseModel):
    """Data untuk membuat satu baris `contents`. ID diisi backend, bukan LLM."""

    model_config = ConfigDict(extra="forbid", str_strip_whitespace=True)

    course_plan_week_id: str = Field(min_length=1)
    title: str = Field(min_length=1, max_length=TITLE_MAX_LENGTH)
    content_type: ContentType
    content_data: dict | None = None
    content_markdown: str | None = None
    version: int = Field(default=1, ge=1)
    status: ContentStatus = ContentStatus.DRAFT
    generated_by_agent_run_id: str | None = None


def to_content_creates(
    material: GeneratedLearningMaterial,
    *,
    course_plan_week_id: str,
    agent_run_id: str | None = None,
    version: int = 1,
) -> list[ContentCreate]:
    """Satu LearningItem = satu ContentCreate."""
    return [
        ContentCreate(
            course_plan_week_id=course_plan_week_id,
            title=item.name,
            content_type=ContentType.LEARNING_MATERIAL,
            content_data=item.model_dump(mode="json"),
            content_markdown=item.material_learning,
            version=version,
            status=ContentStatus.DRAFT,
            generated_by_agent_run_id=agent_run_id,
        )
        for item in material.content_learning
    ]


# --------------------------------------------------------------------------
# 4. Baca dari tabel contents
# --------------------------------------------------------------------------


class ContentRead(BaseModel):
    model_config = ConfigDict(from_attributes=True)

    id: str
    course_plan_week_id: str
    title: str
    content_type: ContentType
    content_data: dict | None
    content_markdown: str | None
    version: int
    status: ContentStatus
    generated_by_agent_run_id: str | None
    created_at: datetime | None = None
    updated_at: datetime | None = None
