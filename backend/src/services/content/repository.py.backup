from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from src.models.course import Course
from src.models.course_plan import CoursePlan, CoursePlanStatus
from src.models.course_plan_week import CoursePlanWeek
from src.models.instructor_profile import InstructorProfile
from src.models.rps_analysis import RPSAnalysis

from src.schemas.content import (
    ContentGenerationOutput,
    CourseContext,
    RPSAnalysisContext,
    CoursePlanContext,
    CoursePlanWeekContext,
    InstructorProfileContext,
)


class ContentGenerationRepository:

    @staticmethod
    async def get_context(
        db: AsyncSession,
        course_id: str,
    ) -> ContentGenerationOutput:

        # 1. Ambil Course
        result = await db.execute(
            select(Course).where(Course.id == course_id)
        )
        course = result.scalar_one_or_none()

        if course is None:
            raise ValueError("Course tidak ditemukan")

        # 2. Ambil Instructor Profile
        result = await db.execute(
            select(InstructorProfile).where(
                InstructorProfile.user_id == course.instructor_id
            )
        )
        instructor = result.scalar_one_or_none()

        # 3. Ambil Course Plan yang sudah disetujui
        result = await db.execute(
            select(CoursePlan)
            .where(
                CoursePlan.course_id == course_id,
                CoursePlan.status == CoursePlanStatus.APPROVED,
            )
            .order_by(CoursePlan.version.desc())
            .limit(1)
        )
        course_plan = result.scalar_one_or_none()

        if course_plan is None:
            raise ValueError("Course Plan belum disetujui")

        # 4. Ambil RPS Analysis berdasarkan Course Plan
        result = await db.execute(
            select(RPSAnalysis).where(
                RPSAnalysis.id == course_plan.rps_analysis_id
            )
        )
        rps_analysis = result.scalar_one_or_none()

        if rps_analysis is None:
            raise ValueError("RPS Analysis tidak ditemukan")

        # 5. Ambil Course Plan Weeks
        result = await db.execute(
            select(CoursePlanWeek)
            .where(
                CoursePlanWeek.course_plan_id == course_plan.id
            )
            .order_by(CoursePlanWeek.week_number)
        )
        weeks = result.scalars().all()

        # 6. Susun context
        return ContentGenerationOutput(
            course=CourseContext(
                id=course.id,
                fullname=course.fullname,
                shortname=course.shortname,
                description=course.description,
                semester=course.semester,
                category=course.category,
                course_format=course.course_format,
            ),
            rps_analysis=RPSAnalysisContext(
                version=rps_analysis.version,
                course_identity=rps_analysis.course_identity,
                learning_outcomes=rps_analysis.learning_outcomes,
                objectives=rps_analysis.objectives,
                topics=rps_analysis.topics,
                weekly_distribution=rps_analysis.weekly_distribution,
                teaching_methods=rps_analysis.teaching_methods,
                assessments=rps_analysis.assessments,
                references=rps_analysis.references_data,
            ),
            course_plan=CoursePlanContext(
                id=course_plan.id,
                version=course_plan.version,
                plan_data=course_plan.plan_data,
                weeks=[
                    CoursePlanWeekContext(
                        week_number=week.week_number,
                        title=week.title,
                        learning_outcomes=week.learning_outcomes,
                        topics=week.topics,
                        methods=week.methods,
                        assessment=week.assessment,
                        metadata=week.metadata_,
                    )
                    for week in weeks
                ],
            ),
            instructor_profile=(
                InstructorProfileContext(
                    teaching_style=instructor.teaching_style,
                    expertise=instructor.expertise,
                    delivery_preference=instructor.delivery_preference,
                    language_preference=instructor.language_preference,
                )
                if instructor
                else None
            ),
        )
