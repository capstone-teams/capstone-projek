# Salin ke .env.local lalu sesuaikan.

# ---- Moodle LMS
# Alamat instance Moodle ($CFG->wwwroot); sesuaikan dengan server yang digunakan.
VITE_MOODLE_URL=http://localhost:8080
# Layanan web service yang dipakai login/token.php.
VITE_MOODLE_SERVICE=moodle_mobile_app
# true (default) = data Moodle dummy di browser, tidak butuh server Moodle.
# false = panggil Moodle Web Service sungguhan di VITE_MOODLE_URL.
VITE_MOODLE_MOCK=true

# ---- Backend capstone (Generator Konten AI)
# true = backend dummy di browser. false = panggil FastAPI.
VITE_USE_MOCK=true

# Base URL API yang dipanggil browser.
# - /api/v1 (default) memakai proxy Vite di bawah; request dianggap same-origin
#   sehingga tidak memerlukan CORS.
# - http://localhost:8000/api/v1 memanggil backend langsung (cross-origin).
#   Origin frontend (http://localhost:3000) harus terdaftar pada CORS_ORIGINS
#   backend; nilai default backend/.env.example sudah mencakupnya (BE-06.2).
VITE_API_BASE_URL=/api/v1

# Tujuan proxy Vite untuk path /api (hanya dipakai saat VITE_API_BASE_URL=/api/v1).
# Backend development berjalan di port 8000.
VITE_BACKEND_URL=http://localhost:8000
