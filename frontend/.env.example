# Salin ke .env.local lalu sesuaikan.

# ---- Backend capstone (Single Gateway): login, RPS, workflow, kursus, dan data Moodle lewat backend.
# Mode mock hanya untuk tes otomatis (vite.config.js menyetelnya saat test); biarkan false untuk pemakaian biasa.
VITE_USE_MOCK=false
# VITE_MOODLE_MOCK=false
VITE_RPS_DELETE=false
# Project kursus dari API /courses (bawaan aktif). false = tab Generator AI hanya RPS dan monitoring workflow.
# VITE_COURSE_API=false

# Base URL API yang dipanggil browser.
# - /api/v1 (default) memakai proxy Vite di bawah; request dianggap same-origin
#   sehingga tidak memerlukan CORS saat development lokal.
# - https://caps.njyn.foo/api/v1 memanggil backend secara langsung (cross-origin).
VITE_API_BASE_URL=/api/v1

# Tujuan proxy Vite untuk path /api (hanya dipakai saat VITE_API_BASE_URL=/api/v1).
# Arahkan ke backend lokal (http://localhost:8000) atau server demo (https://caps.njyn.foo).
VITE_BACKEND_URL=https://caps.njyn.foo
