# Salin ke .env.local lalu sesuaikan.

# ---- Moodle LMS
# Alamat instance Moodle ($CFG->wwwroot); sesuaikan dengan server yang digunakan.
VITE_MOODLE_URL=http://localhost:8080
# Layanan web service yang dipakai login/token.php.
VITE_MOODLE_SERVICE=moodle_mobile_app
# true (default) = data Moodle dummy di browser, tidak butuh server Moodle.
# false = panggil Moodle Web Service sungguhan di VITE_MOODLE_URL.
VITE_MOODLE_MOCK=true

# ---- Backend capstone (Generator Konten AI)
# true = backend dummy di browser. false = panggil FastAPI.
VITE_USE_MOCK=true
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_URL=http://localhost:8000
