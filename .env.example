# Root Environment Variables Example for Capstone Project
# Copy this file to .env for local development environment configuration.

# Backend Configuration
APP_NAME="Capstone Moodle Agentic AI"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Security & Authentication
SECRET_KEY="your-super-secret-key-min-32-chars-change-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration (PostgreSQL)
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="your_db_password_here"
DB_NAME="capstone_moodle_db"
DATABASE_URL=""

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Moodle Integration
MOODLE_BASE_URL="http://localhost:8080/moodle"
MOODLE_WEB_SERVICE_TOKEN="your_moodle_webservice_token_here"

# LLM / Agentic AI Configuration
LLM_PROVIDER="openai"
LLM_API_KEY="your_llm_api_key_here"
LLM_MODEL="gpt-4o-mini"
